DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DATABASE=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=
JWT_SECRET=
JWT_ISSUER=
# Needed to generate and read the RS256 signing keys (/connect/generate-keys).
# Only required to run the real app / load test; set it in your own .env or shell.
# Left commented so the benchmark does not treat it as a required config value.
# JWT_PRIVATE_KEY_PASSPHRASE=

# Load test settings. These are read by `npm run test:load` from the shell
# (export them), not by the app. Use the seeded user from
# .github/load-tests/test-user.sql.
# LOAD_TESTS_BASE_URL=http://localhost:3000
# LOAD_TESTS_USERNAME=
# LOAD_TESTS_PASSWORD=
# LOAD_TESTS_CLIENT_ID=
# LOAD_TESTS_CLIENT_SECRET=
# Set LOAD_TESTS_UPDATE_BASELINE=1 to record a baseline
# LOAD_TESTS_UPDATE_BASELINE=1
