pipeline {
    agent { label 'jenkins-dynamic-slave' }
    environment {
        DOCKER = credentials('sf-reference-arch-dockerhub')
    }
    stages {
        stage('Build') {
            steps {
                sh "chmod +x ./sandbox/ci_build.sh"
                sh "cd sandbox && DOCKER_USERNAME=\"\$DOCKER_USR\" DOCKER_PASSWORD=\"\$DOCKER_PSW\" ./ci_build.sh ${env.WORKSPACE}/sandbox true"
            }
        }
    }
}